{
  "name": "slotforge-decals",
  "productName": "SlotForge Decals",
  "version": "0.4.0",
  "description": "An offline decal studio for slotcar builders",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "theDutchmanJames",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "format": "prettier --write \"src/**/*.cjs\" \"renderer/**/*.{js,css}\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.cjs\" \"renderer/**/*.{js,css}\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\"",
    "build:icons": "node scripts/build-icon.cjs",
    "pack": "npm run build:icons && node scripts/pack.cjs",
    "setup:converter": "node scripts/setup-converter.cjs",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:desktop": "node scripts/test-desktop.cjs",
    "test:package": "node scripts/package-smoke.cjs"
  },
  "dependencies": {
    "mupdf": "1.28.1"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "paper": "0.12.18",
    "playwright": "1.56.1",
    "prettier": "3.10.1",
    "resedit": "1.7.2",
    "sharp": "0.35.5"
  },
  "homepage": "https://github.com/theDutchmanJames/SlotForgeDecals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theDutchmanJames/SlotForgeDecals.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "nl.slotforge.decals",
    "productName": "SlotForge Decals",
    "directories": {
      "output": "dist/v${version}"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "vendor/imagetracer/**/*",
      "vendor/PDF-LIB-LICENSE.md",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD-PARTY-NOTICES.txt",
      "vendor/paper/**/*"
    ],
    "asarUnpack": [
      "node_modules/mupdf/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/ghostscript",
        "to": "ghostscript",
        "filter": [
          "bin/gs",
          "bin/gswin64c.exe",
          "bin/gsdll64.dll",
          "doc/COPYING"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "SlotForgeDecals-${version}-windows-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "SlotForgeDecals-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SlotForge Decals",
      "uninstallDisplayName": "SlotForge Decals",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "SlotForgeDecals-${version}-mac-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "15.0"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "SlotForgeDecals-${version}-linux-${arch}.${ext}",
      "icon": "assets/icon.png",
      "category": "Graphics",
      "maintainer": "theDutchmanJames <thedutchmanjames@gmail.com>",
      "synopsis": "Decal studio for slotcar builders"
    }
  }
}
